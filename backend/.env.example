APP_NAME=Ognivo
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# ALLOW_FAKE_DRIVER=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ognivo
DB_USERNAME=ognivo_user
DB_PASSWORD=secret_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST="localhost"
# REVERB_PORT=8080
# REVERB_SCHEME="http"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=400

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VM_ACTION_RATE_LIMIT=10
VM_ACTION_RATE_LIMIT_DECAY_MINUTES=1

# Audit Logging & Tamper Resistance
# audit connection: user audit_writer (INSERT/SELECT on audit_logs and audit_seals)
AUDIT_DB_USERNAME=audit_writer
AUDIT_DB_PASSWORD=CHANGE_ME

# audit_maintenance connection: user audit_maintenance (prune/pseudonymise only)
AUDIT_MAINT_DB_USERNAME=audit_maintenance
AUDIT_MAINT_DB_PASSWORD=CHANGE_ME

# Migration connection: DDL and grants; used only when AUDIT_STRICT_GRANTS=true
DB_MIGRATION_USERNAME=migration_user
DB_MIGRATION_PASSWORD=CHANGE_ME

# Strict grants mode: false in development, true in production
AUDIT_STRICT_GRANTS=false

# Sealing key and identifier (AUDIT_HMAC_KEY must be at least 32 random bytes / 64 hex chars)
AUDIT_HMAC_KEY_ID=v1
AUDIT_HMAC_KEY=CHANGE_ME

# Salt for pseudonymising deleted users
AUDIT_PSEUDONYM_SALT=CHANGE_ME

# Audit tunables
AUDIT_RETENTION_DAYS=400
AUDIT_SEAL_DELAY_SECONDS=120
AUDIT_ATTEMPTED_EMAIL_DAYS=30
AUDIT_LOG_STDERR=false

