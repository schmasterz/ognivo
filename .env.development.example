# Application Environment
APP_NAME="Ognivo (Dev)"
APP_ENV=local
APP_KEY=CHANGE_ME
APP_DEBUG=true
APP_URL=http://localhost

# Database (MySQL 8.4)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ognivo
DB_USERNAME=ognivo_user
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# Redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Broadcasting & Reverb
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ognivo
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME

# Internal broadcast connection used by backend & queue workers
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Allowed origins for client WebSocket connections (comma-separated)
REVERB_ALLOWED_ORIGINS=*

# Frontend Public Variables
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_REVERB_APP_KEY=CHANGE_ME
NEXT_PUBLIC_REVERB_PORT=8080

# Migrations & Seeders flags for backend entrypoint
RUN_MIGRATIONS=true
RUN_SEEDERS=true

# Audit Logging & Tamper Resistance
# audit connection: user audit_writer (INSERT/SELECT on audit_logs and audit_seals)
AUDIT_DB_USERNAME=audit_writer
AUDIT_DB_PASSWORD=CHANGE_ME

# audit_maintenance connection: user audit_maintenance (prune/pseudonymise only)
AUDIT_MAINT_DB_USERNAME=audit_maintenance
AUDIT_MAINT_DB_PASSWORD=CHANGE_ME

# Migration connection: DDL and grants; used only when AUDIT_STRICT_GRANTS=true
DB_MIGRATION_USERNAME=migration_user
DB_MIGRATION_PASSWORD=CHANGE_ME

# Strict grants mode: false in development, true in production
AUDIT_STRICT_GRANTS=false

# Sealing key and identifier (AUDIT_HMAC_KEY must be at least 32 random bytes / 64 hex chars)
AUDIT_HMAC_KEY_ID=v1
AUDIT_HMAC_KEY=CHANGE_ME

# Salt for pseudonymising deleted users
AUDIT_PSEUDONYM_SALT=CHANGE_ME

# Audit tunables
AUDIT_RETENTION_DAYS=400
AUDIT_SEAL_DELAY_SECONDS=120
AUDIT_ATTEMPTED_EMAIL_DAYS=30
AUDIT_LOG_STDERR=false

